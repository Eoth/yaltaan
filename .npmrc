# Supply chain: no lifecycle script of any dependency runs at install, versions are recorded exactly, a version
# published less than 7 days ago is never picked, and nothing is installed from git.
# Only direct dependencies are placed at the top of node_modules, so only their commands are linked in .bin: a
# dependency of a dependency that ships a command of the same name (TypeScript 6.0 ships `tsc`) cannot replace one.
ignore-scripts=true
save-exact=true
engine-strict=true
min-release-age=7
allow-git=none
install-strategy=shallow
fund=false
update-notifier=false
