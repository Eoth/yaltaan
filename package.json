{
  "name": "yaltaan-workspace",
  "private": true,
  "description": "Workspace of the Yaltaan packages: a native-first TypeScript standard library for applications.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "verify": "bash scripts/verify.sh",
    "typecheck": "tsc -b",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@preact/signals-core": "1.14.4",
    "@rollup/wasm-node": "4.64.0",
    "@types/node": "22.20.5",
    "@typescript/typescript6": "6.0.2",
    "es-toolkit": "1.52.0",
    "esbuild-wasm": "0.28.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  }
}
