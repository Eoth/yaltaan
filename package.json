{
  "name": "yaltaan-workspace",
  "private": true,
  "description": "Workspace of the Yaltaan packages: a native-first TypeScript standard library for applications.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.3 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "verify": "bash scripts/verify.sh",
    "typecheck": "tsc -b && tsc -p packages/angular/tsconfig.json",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@preact/signals-core": "1.14.4",
    "@rollup/wasm-node": "4.64.0",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "22.20.5",
    "@typescript/typescript6": "6.0.2",
    "es-toolkit": "1.52.0",
    "esbuild-wasm": "0.28.2",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "valibot": "1.5.0"
  }
}
