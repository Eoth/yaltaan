{
  "name": "@yaltaan/rules",
  "version": "0.0.0",
  "private": true,
  "description": "Rules of Yaltaan across fields, pure and declarative: on any Standard Schema, in any form engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eoth/yaltaan.git",
    "directory": "packages/rules"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
