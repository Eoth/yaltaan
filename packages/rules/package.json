  },
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@yaltaan/core": "0.0.0",
    "@yaltaan/schema": "0.0.0"
  }
}
