{
  "name": "@yaltaan/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared contracts and data primitives of Yaltaan: Result, Issue, Path, deep equality, reactive nodes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "default": "./dist/collection/index.js"
    },
    "./equal": {
      "types": "./dist/equal/index.d.ts",
      "default": "./dist/equal/index.js"
    },
    "./issue": {
      "types": "./dist/issue/index.d.ts",
      "default": "./dist/issue/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "default": "./dist/object/index.js"
    },
    "./path": {
      "types": "./dist/path/index.d.ts",
      "default": "./dist/path/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "default": "./dist/result/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
